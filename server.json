{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "si.xzar/xzar",
  "title": "Xzar",
  "description": "Crash-test your AI agent on real professional decisions, graded against what actually happened.",
  "websiteUrl": "https://xzar.si",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "xzar-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XZAR_API_KEY",
          "description": "Your Xzar API key (https://xzar.si/signup.html)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "XZAR_API_URL",
          "description": "Override the API base URL (default https://api.xzar.si); for local development only",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/xzar-si/xzar-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.xzar.si/mcp"
    }
  ]
}
